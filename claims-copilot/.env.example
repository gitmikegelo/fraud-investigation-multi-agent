# Claims Copilot — environment configuration
# Copy this file to .env and fill in your values

# ── Domain ─────────────────────────────────────────────────────────────────────
# Which domain plugin to load (must match a key in DOMAIN_REGISTRY)
DOMAIN_MODE=car_insurance

# ── AWS Bedrock ────────────────────────────────────────────────────────────────
AWS_REGION=us-east-1

# AWS Credentials (optional if using `aws configure` / IAM role)
# AWS_ACCESS_KEY_ID=your_access_key_here
# AWS_SECRET_ACCESS_KEY=your_secret_key_here

# Model used by agents/nodes.py (copilot, investigation, dossier agents)
# and document_vision.py (vision checks).  Both default to this value.
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# Optional: separate model for vision checks (defaults to BEDROCK_MODEL_ID)
# BEDROCK_VISION_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# Optional: adjust temperature (0.0 = deterministic, 1.0 = creative)
LLM_TEMPERATURE=0.1

    START --> INIT
    INIT --> ORCH["🎯 Orchestrator<br/>Lead Investigator"]
    
    ORCH -->|INVESTIGATE| INV["🔍 Investigation Agent<br/>AWS Bedrock Claude"]
    ORCH -->|COMPILE| DOS["📝 Dossier Agent<br/>AWS Bedrock Claude"]
    ORCH -->|DONE| END(["✅ Complete"])

    INV --> T1["scan_new_claims"]
    INV --> T2["profile_entity"]
    INV --> T3["compare_to_peers"]
    INV --> T4["get_claim_details"]
    INV --> T5["find_connections"]
    INV --> T6["find_ring"]
    INV --> T7["get_referral_history"]
    
    T1 --> LOOP1["[Investigation Loop<br/>Findings gathered]"]
    T2 --> LOOP1
    T3 --> LOOP1
    T4 --> LOOP1
    T5 --> LOOP1
    T6 --> LOOP1
    T7 --> LOOP1
    
    LOOP1 --> ORCH

    DOS --> D1["assess_evidence"]

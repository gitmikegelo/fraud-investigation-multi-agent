    D4 --> LOOP2
    D5 --> LOOP2
    
    LOOP2 --> ORCH
    
    END --> OUTPUT["📊 Final Dossier<br/>Markdown Report"]
    
    classDef agent fill:#4A90D9,stroke:#2C5F8A,color:#fff,font-weight:bold
    classDef tool fill:#F5A623,stroke:#C77D0A,color:#fff,font-size:11px
    classDef loop fill:#FFE5CC,stroke:#C77D0A,color:#333
    classDef data fill:#7ED321,stroke:#4A8C12,color:#fff,font-weight:bold
    classDef entry fill:#D0021B,stroke:#9B0114,color:#fff,font-weight:bold
    
    class ORCH,INV,DOS agent
    class T1,T2,T3,T4,T5,T6,T7,D1,D2,D3,D4,D5 tool
    class LOOP1,LOOP2 loop
    class INIT data
    class START,END,OUTPUT entry
